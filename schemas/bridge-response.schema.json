{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/user1303836/sbox-agent-bridge/schemas/bridge-response.schema.json",
  "title": "sbox-agent-bridge response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ok"],
  "properties": {
    "id": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["result"]
    },
    {
      "required": ["error"]
    }
  ]
}
